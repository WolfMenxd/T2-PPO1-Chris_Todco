@model POOI_T2_Todco.Models.Alumno
@{ ViewBag.Title = "Actualizar alumno"; }
<h2>Actualizar alumno</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.Hidden("dniOriginal", (string)ViewBag.DniOriginal ?? Model.Dni)
    @Html.ValidationSummary(true)
    @Html.Partial("_FormularioAlumno", Model)
    <button type="submit">Guardar cambios</button>
}
<p>@Html.ActionLink("Volver al listado", "Index")</p>


